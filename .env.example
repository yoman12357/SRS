# Local configuration; copy to .env. All content stays on this machine.
CYBERSRS_DATA_DIR=./data
CYBERSRS_KNOWLEDGE_DIR=./knowledge
CYBERSRS_FRONTEND_DIR=./frontend/dist
CYBERSRS_OLLAMA_BASE_URL=http://127.0.0.1:11434
CYBERSRS_MODEL_NAME=cybersrs-qwen3-4b-ft:latest
CYBERSRS_BASE_MODEL_NAME=qwen3:4b-instruct-2507-q4_K_M
CYBERSRS_EMBEDDING_MODEL=nomic-embed-text:latest
CYBERSRS_OLLAMA_TIMEOUT_SECONDS=600
CYBERSRS_OLLAMA_NUM_CTX=16384
CYBERSRS_OLLAMA_NUM_PREDICT=2600
CYBERSRS_LLM_MAX_RETRIES=0
# Ask configured adapter first; same local base Qwen may correct validation failures.
# Requested and actual model tags are recorded. No mock/template report is substituted.
CYBERSRS_BASE_REPAIR_ENABLED=true
CYBERSRS_ADAPTER_MAX_RETRIES=0
CYBERSRS_GENERATION_TIMEOUT_SECONDS=480
# Includes all model calls and corrections for one section; failure stays explicit.
CYBERSRS_SECTION_TIMEOUT_SECONDS=180
CYBERSRS_COMPACT_REQUIREMENTS_ENABLED=true
# Bound automatic test corrections under the section deadline.
CYBERSRS_ATOMIC_TEST_REPAIR_LIMIT=3
CYBERSRS_OLLAMA_STREAM=true
# Qwen ChatML encoding; same configured models and loopback provider.
CYBERSRS_OLLAMA_RAW_CHATML=true
# Prevent an idle configured sibling from forcing the active model onto CPU.
CYBERSRS_OLLAMA_EXCLUSIVE_MAIN_MODEL=true
CYBERSRS_RAG_TOP_K=4
CYBERSRS_RAG_MIN_SCORE=0.35
CYBERSRS_RAG_ENABLED=true
CYBERSRS_BACKEND_PORT=8010
CYBERSRS_FRONTEND_PORT=5175
CYBERSRS_MAX_UPLOAD_BYTES=10485760
